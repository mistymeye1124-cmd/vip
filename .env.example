# =============================================================================
# PRO ACCESS VAULT VIP BOT — ENVIRONMENT TEMPLATE (.env.example)
# Rename this file to .env and fill in your values
# =============================================================================

# Telegram Bot Token (from @BotFather)
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Admin Telegram User ID(s) (comma-separated if multiple, e.g. 8387415921)
ADMIN_IDS=YOUR_TELEGRAM_USER_ID

# =============================================================================
# FORCE CHANNEL JOIN (চ্যানেলে জয়েন বাধ্যতামূলক করার সেটিংস)
# =============================================================================
# চ্যানেলের আইডি (যেমন: -1001234567890) অথবা ইউজারনেম (যেমন: @my_channel)
# নোট: বটকে অবশ্যই এই চ্যানেলে Administrator বানাতে হবে যেন মেম্বারশিপ চেক করতে পারে!
FORCE_CHANNEL_ID=-100xxxxxxxxxx

# চ্যানেলের জয়েন লিংক (পাবলিক হলে https://t.me/username অথবা প্রাইভেট ইনভাইট লিংক)
FORCE_CHANNEL_LINK=https://t.me/your_channel_or_link

# চ্যানেলের নাম (বটে সুন্দরভাবে দেখানোর জন্য)
FORCE_CHANNEL_NAME=Official Updates Channel

# =============================================================================
# PAYMENT INFORMATION (বিকাশ, নগদ, বাইন্যান্স ও ক্রিপ্টো ওয়ালেট)
# =============================================================================
BKASH_NUMBER=01XXXXXXXXX (Personal - Send Money)
NAGAD_NUMBER=01XXXXXXXXX (Personal - Send Money)
BINANCE_PAY_ID=YOUR_BINANCE_PAY_ID
USDT_TRC20=YOUR_USDT_TRC20_ADDRESS

# =============================================================================
# SYSTEM SETTINGS
# =============================================================================
PRODUCT_NAME=Pro Access Vault - Course Edition
LOG_CHANNEL_ID=
SCHEDULER_INTERVAL_SECONDS=60
REMINDER_HOURS_BEFORE=24
DB_PATH=vault_database.db
BACKUP_DIR=backups
